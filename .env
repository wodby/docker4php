### Documentation available at https://docs.wodby.com/stacks/php/local
### Changelog can be found at https://github.com/wodby/docker4php/releases
### Images tags format explained at https://github.com/wodby/docker4php#images-tags

### PROJECT SETTINGS

PROJECT_NAME=my_php7_project
PROJECT_BASE_URL=php.docker.localhost

DB_NAME=php
DB_USER=php
DB_PASSWORD=php
DB_ROOT_PASSWORD=password
DB_HOST=mariadb
DB_DRIVER=mysql

### --- PHP ----

# Linux (uid 1000 gid 1000)

PHP_TAG=8.5-dev-r2
#PHP_TAG=8.4-dev-r2
#PHP_TAG=8.3-dev-r2
#PHP_TAG=8.2-dev-r2

# macOS (uid 501 gid 20)

#PHP_TAG=8.5-dev-macos-r2
#PHP_TAG=8.4-dev-macos-r2
#PHP_TAG=8.3-dev-macos-r2
#PHP_TAG=8.2-dev-macos-r2

